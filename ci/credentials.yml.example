# Copy this to ci/credentials.yml (already gitignored below), fill in real values.
# If your Concourse is wired to Vault/CredHub, use that instead of a local file --
# `fly set-pipeline` supports either.

github-org: your-github-username-or-org
github-username: your-github-username
# Fine-grained PAT, scoped to just this repo, Contents: Read-only permission --
# GitHub Settings -> Developer settings -> Personal access tokens
github-pat: your-github-pat

artifactory-url: https://your-artifactory-instance.example.com/artifactory
artifactory-username: your-artifactory-username
# An Artifactory API key or access token (Artifactory's own user profile -> Generate Token),
# not your login password -- same principle as GitHub's PAT above.
artifactory-token: your-artifactory-token

cf-api-endpoint: https://api.sys.your-cf-foundation.example.com
cf-username: your-cf-username
cf-password: your-cf-password
cf-org: your-cf-org
cf-space: your-cf-space
cf-skip-cert-check: false
