# Copy to .env and adjust if your backend runs somewhere other than localhost:8080
VITE_API_BASE=http://localhost:8080/api

# Optional -- Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX). Leave unset to disable
# analytics entirely, which is the right call for local dev so your own testing traffic
# doesn't pollute real analytics data.
VITE_GA_MEASUREMENT_ID=
